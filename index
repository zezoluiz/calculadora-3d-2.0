</div>

<script type="module">
// ===== PWA =====
const manifestJSON = { name:"Amorah 3DCalc", short_name:"Amorah3D", start_url:".", display:"standalone", background_color:"#0f172a", theme_color:"#0f172a", orientation:"portrait", icons:[{src:"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 512 512'%3E%3Crect width='512' height='512' rx='100' fill='%230f172a'/%3E%3Ctext x='50%25' y='50%25' text-anchor='middle' dominant-baseline='middle' font-family='sans-serif' font-weight='800' font-size='200' fill='%233b82f6'%3EA3D%3C/text%3E%3C/svg%3E",sizes:"512x512",type:"image/svg+xml",purpose:"any maskable"}] };
const manifestBlob = new Blob([JSON.stringify(manifestJSON)],{type:'application/json'});
document.getElementById('pwa-manifest').setAttribute('href', URL.createObjectURL(manifestBlob));
const swCode = `self.addEventListener('install',e=>self.skipWaiting());self.addEventListener('activate',e=>self.clients.claim());self.addEventListener('fetch',e=>{});`;
if('serviceWorker' in navigator) navigator.serviceWorker.register(URL.createObjectURL(new Blob([swCode],{type:'application/javascript'}))).catch(()=>{});

// ===== STATE =====
window.models = [];
window.sales = [];
window.config = { kwh:0.85, watts:120, printerVal:2000, printerLife:2000, labor:30, maint:50, margin:30, fail:5 };
let currentPhoto = null;
let editCurrentPhoto = null;
let useFirebase = false;
let userId = null;
let db = null;
const appId = typeof __app_id !== 'undefined' ? __app_id : 'amorah-3dcalc';

// ===== HELPERS =====
const fmt = v => 'R$ ' + Number(v).toFixed(2).replace('.', ',');
const fmtShort = v => v >= 1000 ? 'R$' + (v/1000).toFixed(1) + 'k' : 'R$' + Number(v).toFixed(0);
const fmtDate = d => { try { return new Date(d + 'T12:00:00').toLocaleDateString('pt-BR'); } catch(e) { return d; } };
const num = id => parseFloat(document.getElementById(id)?.value) || 0;
const $ = id => document.getElementById(id);
window.fmt = fmt; window.fmtShort = fmtShort; window.fmtDate = fmtDate;

// ===== STORAGE ABSTRACTION =====
// Salva dados — usa Firebase se disponível, senão localStorage
async function persistModel(model) {
  if (useFirebase) {
    const { doc, setDoc } = await import("https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js");
    await setDoc(doc(db,'artifacts',appId,'users',userId,'models',model.id.toString()), model);
  } else {
    const existing = window.models.findIndex(m => m.id === model.id);
    if (existing >= 0) window.models[existing] = model; else window.models.unshift(model);
    saveLocal();
    renderModels(); renderDashboard(); populateSaleSelect();
  }
}
async function removeModel(mid) {
  if (useFirebase) {
    const { doc, deleteDoc } = await import("https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js");
    await deleteDoc(doc(db,'artifacts',appId,'users',userId,'models',mid.toString()));
  } else {
    window.models = window.models.filter(m => m.id !== mid);
    saveLocal(); renderModels(); renderDashboard(); populateSaleSelect();
  }
}
async function persistSale(sale) {
  if (useFirebase) {
    const { doc, setDoc } = await import("https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js");
    await setDoc(doc(db,'artifacts',appId,'users',userId,'sales',sale.id.toString()), sale);
  } else {
    window.sales.unshift(sale);
    saveLocal(); renderSales(); renderDashboard(); renderReport();
  }
}
async function removeSale(sid) {
  if (useFirebase) {
    const { doc, deleteDoc } = await import("https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js");
    await deleteDoc(doc(db,'artifacts',appId,'users',userId,'sales',sid.toString()));
  } else {
    window.sales = window.sales.filter(s => s.id !== sid);
    saveLocal(); renderSales(); renderDashboard(); renderReport();
  }
}
async function persistConfig(cfg) {
  if (useFirebase) {
    const { doc, setDoc } = await import("https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js");
    await setDoc(doc(db,'artifacts',appId,'users',userId,'config','settings'), cfg);
  } else {
    window.config = cfg; saveLocal();
  }
}
function saveLocal() {
  try {
    localStorage.setItem('a3d_models', JSON.stringify(window.models));
    localStorage.setItem('a3d_sales', JSON.stringify(window.sales));
    localStorage.setItem('a3d_config', JSON.stringify(window.config));
    $('badge-models').textContent = window.models.length;
  } catch(e) {}
}
function loadLocal() {
  try {
    window.models = JSON.parse(localStorage.getItem('a3d_models') || '[]');
    window.sales  = JSON.parse(localStorage.getItem('a3d_sales')  || '[]');
    window.config = { ...window.config, ...JSON.parse(localStorage.getItem('a3d_config') || '{}') };
  } catch(e) {}
}

// ===== BOOT: tenta Firebase, cai para localStorage se falhar =====
async function boot() {
  let firebaseConfig = {};
  try { firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : {}; } catch(e) {}

  const hasFirebase = firebaseConfig && firebaseConfig.projectId;

  if (hasFirebase) {
    try {
      const { initializeApp }           = await import("https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js");
      const { getAuth, signInWithCustomToken, signInAnonymously, onAuthStateChanged } = await import("https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js");
      const { getFirestore, collection, onSnapshot } = await import("https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js");

      const fbApp = initializeApp(firebaseConfig);
      const auth  = getAuth(fbApp);
      db = getFirestore(fbApp);
      useFirebase = true;

      // timeout de segurança: se Firebase demorar >6s, usa localStorage
      const safetyTimer = setTimeout(() => { useFirebase = false; bootLocal(); }, 6000);

      onAuthStateChanged(auth, async user => {
        if (user) {
          clearTimeout(safetyTimer);
          userId = user.uid;
          // Escuta modelos
          onSnapshot(collection(db,'artifacts',appId,'users',userId,'models'), snap => {
            window.models = snap.docs.map(d=>d.data()).sort((a,b)=>new Date(b.createdAt)-new Date(a.createdAt));
            $('badge-models').textContent = window.models.length;
            renderModels(); renderDashboard(); populateSaleSelect(); hideLoader();
          }, () => { useFirebase = false; bootLocal(); });
          // Escuta vendas
          onSnapshot(collection(db,'artifacts',appId,'users',userId,'sales'), snap => {
            window.sales = snap.docs.map(d=>d.data()).sort((a,b)=>new Date(b.date)-new Date(a.date));
            renderSales(); renderDashboard(); renderReport();
          });
          // Escuta config
          const { doc, onSnapshot: onSnap2 } = await import("https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js");
          onSnap2(doc(db,'artifacts',appId,'users',userId,'config','settings'), docSnap => {
            if (docSnap.exists()) window.config = { ...window.config, ...docSnap.data() };
            applyConfigToCalc(); loadConfig();
          });
        }
      });

      try {
        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) await signInWithCustomToken(auth, __initial_auth_token);
        else await signInAnonymously(auth);
      } catch(e) { clearTimeout(safetyTimer); useFirebase = false; bootLocal(); }

    } catch(e) { useFirebase = false; bootLocal(); }
  } else {
    bootLocal();
  }
}

function bootLocal() {
  loadLocal();
  applyConfigToCalc(); loadConfig();
  renderModels(); renderDashboard(); renderSales(); renderReport(); populateSaleSelect();
  hideLoader();
}

function hideLoader() {
  const loader = $('app-loader');
  if (loader) { loader.style.opacity = '0'; setTimeout(() => loader.style.display = 'none', 500); }
  $('main-app-container').style.display = 'flex';
  calcCost();
}

// ===== NAVIGATION =====
window.navigate = function(page) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  $('page-' + page).classList.add('active');
  document.querySelectorAll('.nav-item').forEach(n => { if (n.getAttribute('onclick')?.includes("'"+page+"'")) n.classList.add('active'); });
  if (page === 'dashboard') renderDashboard();
  if (page === 'models') renderModels();
  if (page === 'sales') renderSales();
  if (page === 'report') renderReport();
  window.scrollTo({ top: 0, behavior: 'smooth' });
};

// ===== CALCULATOR =====
window.calcCost = function() {
  const weight = num('c-weight'), filPrice = num('c-fil-price'), failPct = num('c-fail') / 100;
  const supportPct = num('c-support') / 100, time = num('c-time'), watts = num('c-watts');
  const kwh = num('c-kwh'), laborTime = num('c-labor-time'), laborRate = num('c-labor-rate');
  const pack = num('c-pack'), extra = num('c-extra'), printerVal = num('c-printer-val');
  const printerLife = num('c-printer-life') || 1, maint = num('c-maint');
  const margin = num('c-margin') / 100, platform = num('c-platform') / 100;

  const filBase = (weight / 1000) * filPrice;
  const filTotal = (filBase + filBase * supportPct) * (1 + failPct);
  const energyCost = (watts / 1000) * time * kwh;
  const laborCost = laborTime * laborRate;
  const depCost = (printerVal / printerLife) * time;
  const failCost = filBase * failPct;
  const extraCost = pack + extra;
  const maintCost = (maint / 176) * time;
  const total = filTotal + energyCost + laborCost + depCost + failCost + extraCost + maintCost;
  const suggestedPrice = margin < 1 ? total / (1 - margin) : total * (1 + margin);
  const finalPrice = suggestedPrice * (1 + platform);

  $('res-filtype').textContent = $('c-fil-type')?.value || 'PLA';
  $('res-fil').textContent = fmt(filTotal);
  $('res-energy').textContent = fmt(energyCost);
  $('res-labor').textContent = fmt(laborCost);
  $('res-dep').textContent = fmt(depCost);
  $('res-fail').textContent = fmt(failCost);
  $('res-extra').textContent = fmt(extraCost);
  $('res-maint').textContent = fmt(maintCost);
  $('res-total').textContent = fmt(total);

  // Price suggestions
  const prices = [{l:'20%',p:0.2,c:'margin-20'},{l:'30%',p:0.3,c:'margin-30'},{l:'50%',p:0.5,c:'margin-50'}];
  $('price-suggestion').innerHTML = prices.map(p => `<div class="price-row ${p.c}"><span class="p-label">Margem ${p.l}</span><span class="p-val">${fmt(total/(1-p.p))}</span></div>`).join('')
    + (margin > 0 ? `<div class="price-row" style="background:var(--orange-glow);border:1px solid rgba(59,130,246,0.3)"><span class="p-label" style="color:var(--orange-light)">Alvo ${(margin*100).toFixed(0)}%</span><span class="p-val" style="color:var(--orange)">${fmt(finalPrice)}</span></div>` : '');

  // Donut
  const parts = [{l:'Material',v:filTotal,c:'#3b82f6'},{l:'Energia',v:energyCost,c:'#f59e0b'},{l:'Labor',v:laborCost,c:'#10b981'},{l:'Deprec.',v:depCost,c:'#6366f1'},{l:'Falha',v:failCost,c:'#ef4444'},{l:'Extras',v:extraCost,c:'#8b5cf6'}].filter(p=>p.v>0);
  if (total > 0) {
    const circ = 201.06; let offset = 0; let svg = '';
    parts.forEach(p => { const dash = (p.v/total)*circ; svg += `<circle cx="40" cy="40" r="32" fill="none" stroke="${p.c}" stroke-width="12" stroke-dasharray="${dash} ${circ-dash}" stroke-dashoffset="${-offset}" transform="rotate(-90 40 40)"/>`; offset += dash; });
    $('donut-svg').innerHTML = `<circle cx="40" cy="40" r="32" fill="none" stroke="var(--bg-elevated)" stroke-width="12"/>${svg}`;
    $('donut-legend').innerHTML = parts.map(p => `<div style="display:flex;align-items:center;gap:8px;font-size:12px;margin-bottom:6px"><div style="width:10px;height:10px;border-radius:3px;background:${p.c};flex-shrink:0"></div><span style="color:var(--text-secondary);flex:1">${p.l}</span><b style="font-family:'JetBrains Mono',monospace">${((p.v/total)*100).toFixed(0)}%</b></div>`).join('');
  }
  return { filTotal, energyCost, laborCost, depCost, failCost, extraCost, maintCost, total, suggestedPrice: finalPrice };
};

window.clearCalc = function() {
  ['c-name','c-desc','c-link'].forEach(f => { if($(f)) $(f).value = ''; });
  $('c-link-source').value = '';
  // Reset sliders
  $('c-fail').value = window.config.fail || 5;       $('c-fail-val').textContent = (window.config.fail||5) + '%';
  $('c-support').value = 0;                           $('c-support-val').textContent = '0%';
  $('c-margin').value = window.config.margin || 30;  $('c-margin-val').textContent = (window.config.margin||30) + '%';
  $('c-platform').value = 0;                          $('c-platform-val').textContent = '0%';
  // Reset photo
  removePhoto({ preventDefault:()=>{}, stopPropagation:()=>{} });
  applyConfigToCalc();
};

window.saveModel = async function() {
  const name = $('c-name').value.trim(); if (!name) { showToast('Informe o nome!','error'); return; }
  const costs = calcCost();
  const model = {
    id: Date.now(), name, cat: $('c-cat').value, desc: $('c-desc').value,
    filType: $('c-fil-type').value, photo: currentPhoto || null,
    link: $('c-link').value.trim() || null, linkSource: $('c-link-source').value || null,
    cost: costs.total, suggestedPrice: costs.suggestedPrice,
    weight: num('c-weight'), time: num('c-time'), createdAt: new Date().toISOString(),
    params: {
      weight: num('c-weight'), filPrice: num('c-fil-price'), filType: $('c-fil-type').value,
      fail: num('c-fail'), support: num('c-support'), time: num('c-time'),
      watts: num('c-watts'), kwh: num('c-kwh'), laborTime: num('c-labor-time'),
      laborRate: num('c-labor-rate'), pack: num('c-pack'), extra: num('c-extra'),
      printerVal: num('c-printer-val'), printerLife: num('c-printer-life'),
      maint: num('c-maint'), margin: num('c-margin'), platform: num('c-platform')
    }
  };
  try { await persistModel(model); showToast('Modelo salvo!','success'); navigate('models'); }
  catch(e) { showToast('Erro ao salvar.','error'); }
};

// ===== MODELS =====
window.renderModels = function() {
  const s = $('model-search')?.value.toLowerCase() || '';
  const c = $('model-filter-cat')?.value || '';
  let list = window.models.filter(m => (!s || m.name.toLowerCase().includes(s) || (m.desc||'').toLowerCase().includes(s)) && (!c || m.cat === c));
  if (list.length === 0) {
    $('models-grid').innerHTML = `<div class="empty-state" style="grid-column:1/-1"><div class="empty-icon">🖨</div><div class="empty-title">Nenhum modelo encontrado</div><div class="empty-sub">Use a calculadora para criar e salvar modelos.</div></div>`;
    return;
  }
  $('models-grid').innerHTML = list.map(m => {
    const sold = window.sales.filter(s => s.modelId == m.id).reduce((a,s) => a+s.qty, 0);
    const linkHtml = m.link ? `<a class="model-link-btn" href="${m.link}" target="_blank" rel="noopener">🔗 ${m.linkSource || 'Ver modelo'} ↗</a>` : '';
    return `<div class="model-card" style="padding-top:0">
      ${m.photo ? `<img class="model-thumb" src="${m.photo}" alt="${m.name}">` : `<div class="model-thumb-placeholder">🧊</div>`}
      <div style="font-family:'Outfit';font-weight:700;font-size:16px;margin-bottom:6px">${m.name}</div>
      ${linkHtml}
      <div style="font-size:12px;color:var(--text-tertiary);margin-bottom:14px;font-family:'JetBrains Mono'">${m.filType||'—'} · ${m.weight}g · ${m.time}h</div>
      <div style="display:flex;gap:10px;margin-bottom:16px">
        <div style="flex:1;background:var(--bg-elevated);padding:10px;border-radius:8px;text-align:center"><div style="font-size:10px;color:var(--text-tertiary);text-transform:uppercase;letter-spacing:1px">Custo</div><b style="font-family:'JetBrains Mono'">${fmt(m.cost)}</b></div>
        <div style="flex:1;background:var(--teal-glow);padding:10px;border-radius:8px;text-align:center;border:1px solid rgba(16,185,129,0.2)"><div style="font-size:10px;color:var(--teal);text-transform:uppercase;letter-spacing:1px">Venda</div><b style="font-family:'JetBrains Mono';color:var(--teal)">${fmt(m.suggestedPrice)}</b></div>
        <div style="flex:1;background:var(--bg-elevated);padding:10px;border-radius:8px;text-align:center"><div style="font-size:10px;color:var(--text-tertiary);text-transform:uppercase;letter-spacing:1px">Vendidos</div><b style="font-family:'JetBrains Mono'">${sold}</b></div>
      </div>
      <div style="display:flex;gap:8px;margin-top:auto">
        <button class="btn btn-primary btn-sm" style="flex:1" onclick="loadModel(${m.id})">↗ Recalcular</button>
        <button class="btn btn-secondary btn-sm" onclick="openEditModal(${m.id})">✏</button>
        <button class="btn btn-danger btn-sm" onclick="deleteModel(${m.id})">🗑</button>
      </div>
    </div>`;
  }).join('');
};

window.loadModel = function(mid) {
  const m = window.models.find(x => x.id === mid); if (!m || !m.params) return;
  const p = m.params;
  $('c-name').value = m.name; $('c-cat').value = m.cat; $('c-desc').value = m.desc || '';
  $('c-link').value = m.link || ''; $('c-link-source').value = m.linkSource || '';
  // All params
  $('c-weight').value = p.weight; $('c-fil-price').value = p.filPrice; $('c-fil-type').value = p.filType;
  $('c-fail').value = p.fail;     $('c-fail-val').textContent = p.fail + '%';
  $('c-support').value = p.support; $('c-support-val').textContent = p.support + '%';
  $('c-time').value = p.time;     $('c-watts').value = p.watts; $('c-kwh').value = p.kwh;
  $('c-labor-time').value = p.laborTime; $('c-labor-rate').value = p.laborRate;
  $('c-pack').value = p.pack;     $('c-extra').value = p.extra;
  $('c-printer-val').value = p.printerVal; $('c-printer-life').value = p.printerLife;
  $('c-maint').value = p.maint;
  $('c-margin').value = p.margin; $('c-margin-val').textContent = p.margin + '%';
  $('c-platform').value = p.platform || 0; $('c-platform-val').textContent = (p.platform||0) + '%';
  // Photo
  if (m.photo) { setPhotoPreview(m.photo); } else { removePhoto({ preventDefault:()=>{}, stopPropagation:()=>{} }); }
  navigate('calc'); calcCost();
};

window.openEditModal = function(mid) {
  const m = window.models.find(x => x.id === mid); if (!m) return;
  $('edit-id').value = m.id;
  $('edit-name').value = m.name;
  $('edit-cat').value = m.cat;
  $('edit-desc').value = m.desc || '';
  $('edit-cost').value = m.cost.toFixed(2);
  $('edit-price').value = m.suggestedPrice.toFixed(2);
  $('edit-link').value = m.link || '';
  $('edit-link-source').value = m.linkSource || '';
  // Photo
  editCurrentPhoto = m.photo || null;
  if (m.photo) {
    $('edit-photo-preview').src = m.photo; $('edit-photo-preview').style.display = 'block';
    $('edit-photo-area').classList.add('has-photo'); $('edit-photo-placeholder').style.display = 'none'; $('edit-photo-remove').style.display = 'block';
  } else {
    $('edit-photo-preview').style.display = 'none'; $('edit-photo-area').classList.remove('has-photo');
    $('edit-photo-placeholder').style.display = 'flex'; $('edit-photo-remove').style.display = 'none';
  }
  $('modal-edit').classList.add('open');
};

window.saveEdit = async function() {
  const mid = parseInt($('edit-id').value);
  const m = window.models.find(x => x.id === mid); if (!m) return;
  const updated = {
    ...m,
    name: $('edit-name').value.trim() || m.name,
    cat: $('edit-cat').value,
    desc: $('edit-desc').value,
    cost: parseFloat($('edit-cost').value) || m.cost,
    suggestedPrice: parseFloat($('edit-price').value) || m.suggestedPrice,
    link: $('edit-link').value.trim() || null,
    linkSource: $('edit-link-source').value || null,
    photo: editCurrentPhoto || null,
  };
  try {
    await persistModel(updated);
    closeModal('modal-edit'); showToast('Modelo atualizado!','success');
  } catch(e) { showToast('Erro ao salvar.','error'); }
};

window.deleteModel = async function(mid) {
  if (!confirm('Apagar este modelo? As vendas serão mantidas.')) return;
  try { await removeModel(mid); showToast('Modelo apagado.','success'); }
  catch(e) { showToast('Erro.','error'); }
};

// ===== SALES =====
function populateSaleSelect() {
  const sel = $('s-model'); if (!sel) return;
  sel.innerHTML = window.models.length
    ? window.models.map(m => `<option value="${m.id}">${m.name}</option>`).join('')
    : '<option value="">— Sem modelos cadastrados —</option>';
  if (window.models.length > 0) $('s-price').value = window.models[0].suggestedPrice.toFixed(2);
  sel.onchange = () => { const m = window.models.find(x => x.id == sel.value); if (m) { $('s-price').value = m.suggestedPrice.toFixed(2); updateSalePreview(); } };
}

window.updateSalePreview = function() {
  const m = window.models.find(x => x.id == $('s-model')?.value);
  const q = parseFloat($('s-qty')?.value) || 1;
  const p = parseFloat($('s-price')?.value) || 0;
  if (!m) { $('sale-preview').style.display = 'none'; return; }
  const profit = (p - m.cost) * q;
  $('sp-revenue').textContent = fmt(p * q);
  $('sp-cost').textContent = fmt(m.cost * q);
  $('sp-profit').textContent = fmt(profit);
  $('sp-profit').style.color = profit >= 0 ? 'var(--teal)' : 'var(--red)';
  $('sale-preview').style.display = 'block';
};

window.registerSale = async function() {
  const mId = $('s-model')?.value; if (!mId) { showToast('Selecione um modelo!','error'); return; }
  const m = window.models.find(x => x.id == mId);
  const q = parseFloat($('s-qty').value) || 1;
  const p = parseFloat($('s-price').value) || 0;
  if (p <= 0) { showToast('Informe o preço!','error'); return; }
  const sale = {
    id: Date.now(), modelId: mId, modelName: m.name, qty: q, price: p,
    date: $('s-date').value, channel: $('s-channel').value, obs: $('s-obs').value,
    cost: m.cost, profit: (p - m.cost) * q, revenue: p * q
  };
  try {
    await persistSale(sale);
    $('s-qty').value = 1; $('s-obs').value = ''; $('sale-preview').style.display = 'none';
    showToast('Venda registrada!','success');
  } catch(e) { showToast('Erro ao registrar.','error'); }
};

window.renderSales = function() {
  populateSaleSelect();
  $('sales-count-label').textContent = window.sales.length + ' venda(s)';
  if (window.sales.length === 0) {
    $('sales-table-wrap').innerHTML = `<div class="empty-state"><div class="empty-icon">📊</div><div class="empty-title">Sem vendas ainda</div><div class="empty-sub">Registre sua primeira venda!</div></div>`;
    return;
  }
  $('sales-table-wrap').innerHTML = `<div class="table-wrap"><table>
    <thead><tr><th>Data</th><th>Peça</th><th>Canal</th><th>Qtd</th><th>Unit.</th><th>Receita</th><th>Lucro</th><th></th></tr></thead>
    <tbody>${window.sales.map(s => `
    <tr>
      <td class="td-mono">${fmtDate(s.date)}</td>
      <td style="font-weight:700;color:var(--text-primary)">${s.modelName}</td>
      <td><span class="chip chip-orange">${s.channel}</span></td>
      <td class="td-mono">${s.qty}</td>
      <td class="td-mono">${fmt(s.price)}</td>
      <td class="td-mono">${fmt(s.revenue)}</td>
      <td class="${s.profit>=0?'td-green':'td-red'}">${fmt(s.profit)}</td>
      <td><button class="btn btn-danger btn-sm btn-icon" onclick="deleteSale(${s.id})">🗑</button></td>
    </tr>`).join('')}
    </tbody></table></div>`;
};

window.deleteSale = async function(sid) {
  if (!confirm('Excluir esta venda?')) return;
  try { await removeSale(sid); showToast('Venda excluída.','success'); }
  catch(e) { showToast('Erro.','error'); }
};

// ===== DASHBOARD =====
window.renderDashboard = function() {
  const totalRevenue = window.sales.reduce((a,s) => a+s.revenue, 0);
  const totalProfit = window.sales.reduce((a,s) => a+s.profit, 0);
  const totalUnits = window.sales.reduce((a,s) => a+s.qty, 0);
  $('dash-models').textContent = window.models.length;
  $('dash-revenue').textContent = fmtShort(totalRevenue);
  $('dash-profit').textContent = fmtShort(totalProfit);
  $('dash-units').textContent = totalUnits;

  const rec = window.sales.slice(0, 5);
  $('dash-sales-list').innerHTML = rec.length
    ? rec.map(s => `<div style="display:flex;justify-content:space-between;align-items:center;padding:12px 0;border-bottom:1px solid var(--border)"><div><div style="font-weight:600">${s.modelName} <span style="color:var(--text-tertiary);font-size:12px">×${s.qty}</span></div><div style="font-size:12px;color:var(--text-tertiary);margin-top:2px;font-family:'JetBrains Mono'">${fmtDate(s.date)} · ${s.channel}</div></div><div style="text-align:right"><div style="font-weight:700;color:var(--teal);font-family:'JetBrains Mono'">${fmt(s.revenue)}</div><div style="font-size:12px;color:${s.profit>=0?'var(--teal)':'var(--red)'}">lucro: ${fmt(s.profit)}</div></div></div>`).join('')
    : `<div class="empty-state" style="padding:30px"><div class="empty-icon">📦</div><div class="empty-sub">Nenhuma venda ainda</div></div>`;

  const modelSales = {};
  window.sales.forEach(s => {
    if (!modelSales[s.modelId]) modelSales[s.modelId] = { name: s.modelName, revenue: 0, units: 0 };
    modelSales[s.modelId].revenue += s.revenue; modelSales[s.modelId].units += s.qty;
  });
  const top = Object.values(modelSales).sort((a,b) => b.revenue - a.revenue).slice(0, 5);
  const maxRev = top[0]?.revenue || 1;
  $('dash-top-models').innerHTML = top.length
    ? top.map(m => `<div style="margin-bottom:16px"><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px"><span style="font-size:14px;font-weight:600">${m.name}</span><span style="font-family:'JetBrains Mono';font-size:13px;color:var(--teal)">${fmt(m.revenue)}</span></div><div class="progress-bar"><div class="progress-fill" style="width:${(m.revenue/maxRev*100).toFixed(0)}%;background:var(--teal)"></div></div><div style="font-size:11px;color:var(--text-tertiary);margin-top:4px">${m.units} unidade(s) vendida(s)</div></div>`).join('')
    : `<div class="empty-state" style="padding:30px"><div class="empty-icon">🖨</div><div class="empty-sub">Nenhum modelo vendido</div></div>`;
};

// ===== REPORT =====
window.renderReport = function() {
  const totalRevenue = window.sales.reduce((a,s) => a+s.revenue, 0);
  const totalCost = window.sales.reduce((a,s) => a+(s.cost||0)*s.qty, 0);
  const totalProfit = window.sales.reduce((a,s) => a+s.profit, 0);
  const margin = totalRevenue > 0 ? (totalProfit/totalRevenue*100) : 0;

  const byChannel = {};
  window.sales.forEach(s => {
    if (!byChannel[s.channel]) byChannel[s.channel] = { revenue:0, profit:0, units:0 };
    byChannel[s.channel].revenue += s.revenue; byChannel[s.channel].profit += s.profit; byChannel[s.channel].units += s.qty;
  });

  const byMonth = {};
  window.sales.forEach(s => {
    const mo = s.date?.slice(0,7) || '—';
    if (!byMonth[mo]) byMonth[mo] = { revenue:0, profit:0, units:0 };
    byMonth[mo].revenue += s.revenue; byMonth[mo].profit += s.profit; byMonth[mo].units += s.qty;
  });
  const months = Object.entries(byMonth).sort((a,b)=>a[0].localeCompare(b[0])).slice(-6);
  const maxBar = Math.max(...months.map(([,v])=>v.revenue), 1);

  const modelRank = {};
  window.sales.forEach(s => {
    if (!modelRank[s.modelId]) modelRank[s.modelId] = { name:s.modelName, revenue:0, profit:0, units:0, count:0 };
    modelRank[s.modelId].revenue += s.revenue; modelRank[s.modelId].profit += s.profit;
    modelRank[s.modelId].units += s.qty; modelRank[s.modelId].count++;
  });
  const ranked = Object.values(modelRank).sort((a,b) => b.revenue - a.revenue);

  $('report-body').innerHTML = `
  <div class="stats-grid" style="grid-template-columns:repeat(4,1fr)">
    <div class="stat-card teal"><div class="stat-label">Receita</div><div class="stat-value">${fmtShort(totalRevenue)}</div><div class="stat-sub">${fmt(totalRevenue)}</div></div>
    <div class="stat-card orange"><div class="stat-label">Custos</div><div class="stat-value">${fmtShort(totalCost)}</div><div class="stat-sub">${fmt(totalCost)}</div></div>
    <div class="stat-card yellow"><div class="stat-label">Lucro Líquido</div><div class="stat-value">${fmtShort(totalProfit)}</div><div class="stat-sub">${fmt(totalProfit)}</div></div>
    <div class="stat-card ${margin>=20?'teal':'red'}"><div class="stat-label">Margem Média</div><div class="stat-value">${margin.toFixed(1)}%</div><div class="stat-sub">sobre receita</div></div>
  </div>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-bottom:24px">
    <div class="card">
      <div class="card-title">Receita por Mês</div>
      ${months.length === 0 ? '<div class="empty-state" style="padding:20px">Sem dados</div>' : `
      <div style="display:flex;align-items:flex-end;gap:8px;height:120px">
        ${months.map(([mo,v]) => `<div style="flex:1;display:flex;flex-direction:column;align-items:center;gap:4px">
          <div style="font-size:10px;color:var(--teal);font-family:'JetBrains Mono'">${fmtShort(v.revenue)}</div>
          <div style="width:100%;background:var(--teal);border-radius:4px 4px 0 0;height:${Math.round(v.revenue/maxBar*80)}px;opacity:0.8"></div>
          <div style="font-size:10px;color:var(--text-tertiary);font-family:'JetBrains Mono'">${mo.slice(5)}</div>
        </div>`).join('')}
      </div>`}
    </div>
    <div class="card">
      <div class="card-title">Vendas por Canal</div>
      ${Object.keys(byChannel).length === 0 ? '<div class="empty-state" style="padding:20px">Sem dados</div>' : `
      <div class="table-wrap"><table>
        <thead><tr><th>Canal</th><th>Receita</th><th>Lucro</th><th>Unid.</th></tr></thead>
        <tbody>${Object.entries(byChannel).sort((a,b)=>b[1].revenue-a[1].revenue).map(([ch,v])=>`
        <tr><td>${ch}</td><td class="td-mono">${fmt(v.revenue)}</td><td class="${v.profit>=0?'td-green':'td-red'}">${fmt(v.profit)}</td><td class="td-mono">${v.units}</td></tr>`).join('')}
        </tbody></table></div>`}
    </div>
  </div>

  <div class="card">
    <div class="card-title">Ranking de Modelos</div>
    ${ranked.length === 0 ? '<div class="empty-state" style="padding:20px">Sem vendas registradas</div>' : `
    <div class="table-wrap"><table>
      <thead><tr><th>#</th><th>Modelo</th><th>Vendas</th><th>Unidades</th><th>Receita</th><th>Lucro</th><th>Margem</th></tr></thead>
      <tbody>${ranked.map((m,i) => {
        const mg = m.revenue > 0 ? (m.profit/m.revenue*100) : 0;
        return `<tr>
          <td class="td-mono" style="color:var(--text-tertiary)">${i+1}</td>
          <td style="font-weight:700;color:var(--text-primary)">${m.name}</td>
          <td class="td-mono">${m.count}</td>
          <td class="td-mono">${m.units}</td>
          <td class="td-mono">${fmt(m.revenue)}</td>
          <td class="${m.profit>=0?'td-green':'td-red'}">${fmt(m.profit)}</td>
          <td><span class="chip ${mg>=20?'chip-green':'chip-red'}">${mg.toFixed(0)}%</span></td>
        </tr>`;
      }).join('')}
      </tbody></table></div>`}
  </div>`;
};

