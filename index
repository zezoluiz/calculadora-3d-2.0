};

// ===== MODAL & TOAST =====
window.closeModal = function(mid) { $(mid).classList.remove('open'); };
document.querySelectorAll('.modal-overlay').forEach(el => {
  el.addEventListener('click', e => { if (e.target === el) el.classList.remove('open'); });
});

function showToast(msg, type = 'success') {
  const icon = type === 'success' ? '✓' : '✕';
  const t = document.createElement('div');
  t.className = `toast ${type}`;
  t.innerHTML = `<span class="t-icon">${icon}</span><span>${msg}</span>`;
  document.body.appendChild(t);
  setTimeout(() => { t.style.opacity = '0'; t.style.transform = 'translateX(20px)'; setTimeout(() => t.remove(), 400); }, 2800);
}
window.showToast = showToast;

